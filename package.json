    "cn": "^0.5.2",
    "lucide-react": "^1.81.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "^6.2.5",
    "shadcn": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
